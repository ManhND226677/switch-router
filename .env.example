# Switch-Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
DATA_DIR=/var/lib/switch-router

# Recommended runtime variables
PORT=28701
# HOSTNAME is ignored for binding: Switch-Router is local-first and always binds
# 127.0.0.1. External hosting was removed; a local reverse proxy connects from
# loopback and still works.
NODE_ENV=production

# Optional local maintenance is disabled by default for personal use.
# Set to true only when you explicitly need quota auto-ping.
SWITCH_ROUTER_ENABLE_OPTIONAL_INFRASTRUCTURE=false

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true

# Optional isolated Claude for M365 gateway. Now a DB-backed setting toggled
# in Settings -> Optional Features; this env var only seeds the DB value on
# first run (when the DB has never stored it). OFFICE_MODEL_IDS stays env-only.
OFFICE_GATEWAY_ENABLED=false
# Optional exact model IDs for /office/v1/models. When empty, Claude-named
# models from the existing catalog are exposed.
# OFFICE_MODEL_IDS=anthropic/claude-sonnet-4-20250514,office-claude

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Legacy — removed from the runtime with the auth/login feature; do not set.
# JWT_SECRET, INITIAL_PASSWORD, AUTH_COOKIE_SECURE, REQUIRE_API_KEY,
# BASE_URL, NEXT_PUBLIC_BASE_URL: no longer read anywhere in the codebase.

# Optional extra origins allowed to reach `next dev` dev resources (fonts,
# HMR, chunks). Comma-separated hostnames, no scheme or port; `**.` wildcards
# are supported. Needed when the dashboard is opened through a tunnel or
# preview hostname instead of 127.0.0.1/localhost.
SWITCH_ROUTER_DEV_ORIGINS=

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=switch-router
