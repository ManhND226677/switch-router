# Switch-Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/switch-router

# Recommended runtime variables
PORT=28701
HOSTNAME=127.0.0.1
NODE_ENV=production

# Optional local maintenance is disabled by default for personal use.
# Set to true only when you explicitly need quota auto-ping.
SWITCH_ROUTER_ENABLE_OPTIONAL_INFRASTRUCTURE=false

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Optional isolated Claude for M365 gateway. Disabled by default so existing
# /v1 clients and public surfaces are unchanged until explicitly enabled.
OFFICE_GATEWAY_ENABLED=false
# Optional exact model IDs for /office/v1/models. When empty, Claude-named
# models from the existing catalog are exposed.
# OFFICE_MODEL_IDS=anthropic/claude-sonnet-4-20250514,office-claude

# Optional local callback base URL for OIDC flows.
BASE_URL=http://127.0.0.1:28701
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:28701

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=switch-router
