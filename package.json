{
  "name": "switch-router-app",
  "version": "0.10.9",
  "description": "Switch-Router personal AI gateway dashboard",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 28701",
    "build": "next build --webpack",
    "lint": "eslint .",
    "test": "npm --prefix tests run test:fast",
    "start": "node custom-server.js",
    "dev:bun": "bun --bun next dev --webpack --port 28701",
    "build:bun": "bun --bun next build --webpack",
    "start:bun": "bun custom-server.js",
    "icon": "node scripts/windows/generate-icon.mjs",
    "icons:subset": "python scripts/subset-material-symbols.py",
    "tray": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/tray.ps1",
    "tray:hidden": "wscript //nologo scripts\\windows\\switch-router-tray.vbs",
    "autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-autostart.ps1",
    "autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-autostart.ps1 -Remove",
    "autostart:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/install-autostart.ps1 -Status"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "chalk": "^5.6.2",
    "confbox": "^0.2.4",
    "monaco-editor": "^0.55.1",
    "next": "^16.1.6",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.7.0",
    "sql.js": "^1.14.1",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "material-symbols": "^0.44.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4"
  }
}
